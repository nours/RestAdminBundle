{
    "name": "nours/rest-admin-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "David Coudrier",
            "email": "david.coudrier@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "psr/container": "~2.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "doctrine/annotations": "^2.0",
        "doctrine/data-fixtures": "^2.2",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.6",
        "jms/serializer-bundle": "^5.5",
        "knplabs/knp-menu-bundle": "^3.7",
        "nours/table-bundle": "^3.1",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/doctrine-messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/flex": "^2.4",
        "symfony/monolog-bundle": "^3.0 || ^4.0",
        "symfony/phpunit-bridge": "^7.3 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-info": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/var-exporter": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
      "nours/table-bundle": "Pagination + table view integration",
      "doctrine/doctrine-bundle" : "Support for Doctrine ORM persistence and loading",
      "symfony/security-bundle": "Integrate security checks based on security bundle",
      "knplabs/knp-menu-bundle": "KnpMenu integration (menu voter)"
    },
    "autoload": {
        "psr-0": { "Nours\\RestAdminBundle": "" }
    },
    "target-dir": "Nours/RestAdminBundle",
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "extra": {
        "symfony": {
            "docker": false
        }
    }
}
